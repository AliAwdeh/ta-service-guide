{
  "info": {
    "name": "TA Service Guide",
    "description": "Per-client service guide links for maids.cc. POST resolves which of 14 service guides a client should see and returns an unguessable /v/<code> link.\n\nSet the collection variables `baseUrl` and `apiToken` first.\n\nFull reference: docs/API.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "apiToken",
      "value": "change-me"
    },
    {
      "key": "token",
      "value": "",
      "description": "A guide token, set from a POST response."
    }
  ],
  "item": [
    {
      "name": "Create \u2014 resolved from client data",
      "description": "The production path: send the ERP's own fields and let the API pick the guide.",
      "item": [
        {
          "name": "Filipina in the Philippines (Dubai file)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/guides",
              "host": ["{{baseUrl}}"],
              "path": ["api", "guides"]
            },
            "description": "EMIRATE sets the private entry permit fee (Dubai AED 2,614 incl. a refundable AED 2,000 deposit; others AED 450) and gates the deposit-refund section.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"CLIENT_ID\": 1001,\n  \"NATIONALITY\": \"Philippines\",\n  \"MAID_LOCATION\": \"in-country\",\n  \"EMIRATE\": \"dubai\",\n  \"ROLE\": \"maid\",\n  \"GENDER\": \"female\",\n  \"ref\": \"whatsapp\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Ethiopian in Ethiopia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/guides",
              "host": ["{{baseUrl}}"],
              "path": ["api", "guides"]
            },
            "description": "MAID_LOCATION is REQUIRED for Ethiopian \u2014 the in-country guide adds a 39-day GCC and 30-day pre-departure that a maid abroad skips.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"CLIENT_ID\": 1002,\n  \"NATIONALITY\": \"Ethiopia\",\n  \"MAID_LOCATION\": \"in-country\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Ethiopian outside Ethiopia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/guides",
              "host": ["{{baseUrl}}"],
              "path": ["api", "guides"]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"CLIENT_ID\": 1003,\n  \"NATIONALITY\": \"ethiopian\",\n  \"MAID_LOCATION\": \"outside-country\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Indian ECNR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/guides",
              "host": ["{{baseUrl}}"],
              "path": ["api", "guides"]
            },
            "description": "PASSPORT_TYPE is REQUIRED for Indian.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"CLIENT_ID\": 1004,\n  \"NATIONALITY\": \"India\",\n  \"PASSPORT_TYPE\": \"ECNR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Indian Male ECR (driver)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/guides",
              "host": ["{{baseUrl}}"],
              "path": ["api", "guides"]
            },
            "description": "GENDER is REQUIRED for Indian ECR \u2014 the male route needs an OK to Board clearance. ROLE changes the designation noun throughout.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"CLIENT_ID\": 1005,\n  \"NATIONALITY\": \"indian\",\n  \"PASSPORT_TYPE\": \"ECR\",\n  \"GENDER\": \"male\",\n  \"ROLE\": \"driver\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Indian Female ECR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiToken}}"
              },
              {
                "key": "Content-Type",
