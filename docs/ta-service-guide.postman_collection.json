    },
    {
      "name": "Create \u2014 pinned guide",
      "description": "Skip resolution when you already know which guide applies. A pinned guide survives later discriminator edits.",
      "item": [
        {
          "name": "Pin a guide with SERVICE_GUIDE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/guides",
              "host": ["{{baseUrl}}"],
              "path": ["api", "guides"]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"CLIENT_ID\": 2001,\n  \"SERVICE_GUIDE\": \"sri-lankan-in-sri-lanka\",\n  \"ROLE\": \"maid\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Read",
      "item": [
        {
          "name": "Get a guide by token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/guides?token={{token}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "guides"],
              "query": [
                {
                  "key": "token",
                  "value": "{{token}}"
                }
              ]
            },
            "description": "Accepts a bare token or a full/partial link. Bearer-gated internal tooling, so this returns clientId; the public /v/ path never does."
          }
        }
      ]
    },
    {
      "name": "Correct in place (PATCH)",
      "description": "The token never changes, so a link already sent on WhatsApp keeps working and shows the corrected guide.",
      "item": [
        {
          "name": "Change nationality \u2014 guide follows",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/guides",
              "host": ["{{baseUrl}}"],
              "path": ["api", "guides"]
            },
            "description": "Re-resolves the guide from the merged row.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{token}}\",\n  \"NATIONALITY\": \"Uganda\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Rejected: incomplete merge (rolls back)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/guides",
              "host": ["{{baseUrl}}"],
              "path": ["api", "guides"]
            },
            "description": "422. The merged row would have no PASSPORT_TYPE, so the patch is rolled back and the link keeps rendering what it did before.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{token}}\",\n  \"NATIONALITY\": \"indian\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Accepted: same change with the discriminator",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/guides",
              "host": ["{{baseUrl}}"],
              "path": ["api", "guides"]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{token}}\",\n  \"NATIONALITY\": \"indian\",\n  \"PASSPORT_TYPE\": \"ECNR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Fix a typo in the role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/guides",
              "host": ["{{baseUrl}}"],
              "path": ["api", "guides"]
            },
            "description": "",
            "body": {
