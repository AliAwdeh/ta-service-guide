        {
          "name": "Visa-only package (wins over nationality)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/guides",
              "host": ["{{baseUrl}}"],
              "path": ["api", "guides"]
            },
            "description": "PACKAGE=visa-only short-circuits nationality entirely.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"CLIENT_ID\": 1012,\n  \"NATIONALITY\": \"Philippines\",\n  \"MAID_LOCATION\": \"in-country\",\n  \"PACKAGE\": \"visa-only\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Unknown nationality falls back to Other",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
