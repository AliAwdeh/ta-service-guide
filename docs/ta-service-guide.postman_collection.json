              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/guides",
              "host": ["{{baseUrl}}"],
              "path": ["api", "guides"]
            },
            "description": "The female ECR route is a tourist visa where the client must have AED 2,000 in cash ready for immigration \u2014 which is why GENDER cannot be defaulted.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"CLIENT_ID\": 1006,\n  \"NATIONALITY\": \"indian\",\n  \"PASSPORT_TYPE\": \"ECR\",\n  \"GENDER\": \"female\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
