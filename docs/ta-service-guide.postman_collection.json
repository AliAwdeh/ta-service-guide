            ],
            "url": {
              "raw": "{{baseUrl}}/api/guides",
              "host": ["{{baseUrl}}"],
              "path": ["api", "guides"]
            },
            "description": "Unrecognised picklist values resolve to the generic guide rather than erroring. Check resolved.serviceGuide in the response.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"CLIENT_ID\": 1013,\n  \"NATIONALITY\": \"Georgian\"\n}",
